# Career Copilot backend — environment variables.
# Copy this file to .env and fill in real values for local development.

# ── In-process background scheduler ──────────────────────────────────
# APScheduler runs the notifications dispatcher + eligibility-recompute
# worker inside the FastAPI process. Default is "false" so dev/test/CI
# boots don't fire the cron loop. Production must set this to "true" on
# exactly ONE backend instance (APScheduler is not distributed).
ENABLE_SCHEDULER=false

# ── SerpApi discovery adapter ────────────────────────────────────────
# Key for the SerpApi-backed discovery sources (serpapi_jobs / serpapi_web).
# The key lives ONLY here / in the backend environment — never in the DB,
# seed SQL, or frontend bundle. Leave blank to disable SerpApi discovery
# (the adapters raise RuntimeError when it is unset).
SERPAPI_API_KEY=
