# E2E environment — copy to app/frontend/e2e/.env and fill in.
# Locally these come from `supabase status` after `supabase start`.

# Where the served SPA is reachable (Playwright webServer serves the build here).
E2E_BASE_URL=http://127.0.0.1:3000

# FastAPI backend root (no trailing slash; the suite appends /api/...).
E2E_BACKEND_URL=http://127.0.0.1:8000

# Supabase — MUST be a local instance (http://127.0.0.1:...).
# The suite writes test data; pointing it at a *.supabase.co host is blocked
# by a hard guard in fixtures/env.ts that fails fast with a clear error.
# Get these values from: supabase start && supabase status  (in app/supabase/)
E2E_SUPABASE_URL=http://127.0.0.1:54321
E2E_SUPABASE_ANON_KEY=replace-with-anon-key
E2E_SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Seeded fixtures (defaults match app/supabase/seeds/e2e_fixtures.sql).
E2E_TEMPLATE_SLUG=ibps-po-prelims-mock-1
E2E_USER_EMAIL=e2e-aspirant@example.com
E2E_USER_PASSWORD=E2e-passw0rd!
