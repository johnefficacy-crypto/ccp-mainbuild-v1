{
  "name": "career-copilot-frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-query": "^5.59.20",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "framer-motion": "^11.11.9",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.56.0",
    "react-router-dom": "^6.26.2",
    "react-scripts": "5.0.1",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^14.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test --watchAll=false",
    "check:study-copy": "bash ../../scripts/check-study-plan-copy.sh",
    "check:bundle": "node ../../scripts/check-bundle.js",
    "check:bundle-budget": "node ../../scripts/check-bundle.js",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "e2e:report": "playwright show-report e2e/playwright-report"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ],
    "overrides": [
      {
        "files": [
          "src/index.js",
          "src/App.js",
          "src/routes/**/*.jsx",
          "src/pages/**/*.jsx",
          "src/features/**/*.jsx",
          "src/components/**/*.jsx",
          "src/shared/**/*.jsx",
          "src/lib/**/*.jsx"
        ],
        "excludedFiles": [
          "src/features/onboarding-chat/**/*.jsx"
        ],
        "rules": {
          "no-restricted-imports": [
            "error",
            {
              "paths": [
                "framer-motion"
              ]
            }
          ]
        }
      }
    ]
  },
  "jest": {
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\](?!(date-fns|react-day-picker)[/\\\\]).+\\.(js|jsx|mjs|cjs|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ]
  }
}
